{
  "name": "studio-zebra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:up": "docker compose up -d --wait dynamodb",
    "db:down": "docker compose down",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm deps && pnpm test && pnpm spec-coverage",
    "deps": "depcruise . --config .dependency-cruiser.cjs",
    "spec-coverage": "node scripts/harness/src/spec-coverage-cli.ts",
    "test-tamper": "node scripts/harness/src/test-tamper-cli.ts",
    "build": "pnpm -r --if-present build",
    "dev:site": "pnpm --filter @zebra/site-zebra dev",
    "dev:admin": "pnpm --filter @zebra/admin dev",
    "dev:api": "pnpm --filter @zebra/api dev",
    "expected-failures": "node scripts/harness/src/expected-failures-cli.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1141.0",
    "@types/node": "24.19.0",
    "@zebra/eslint-config": "workspace:*",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
